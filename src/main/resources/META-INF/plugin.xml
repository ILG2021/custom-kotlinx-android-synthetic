<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.kevin58cmd.customkotlinxandroidsynthetic</id>
    <name>Synthetic Compatibility</name>
    <vendor>kevin</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Synthetic compatibility" displayType="BALLOON"/>
        <postStartupActivity implementation="com.github.kevin58cmd.customkotlinxandroidsynthetic.startup.SyntheticStartupActivity" />
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>
    <actions>
        <group id="SyntheticCompat.Tools" text="Synthetic Compatibility" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
        <action id="SyntheticCompat.MigrateResourceSwitch"
                class="com.github.kevin58cmd.customkotlinxandroidsynthetic.actions.MigrateResourceSwitchAction"
                text="Convert R.id Switches to If/Else (Whole Project)..."
                description="Preview and convert Java switches using non-constant resource IDs across the project">
            <add-to-group group-id="SyntheticCompat.Tools" anchor="last"/>
        </action>
        <action id="SyntheticCompat.MigrateParcelize"
                class="com.github.kevin58cmd.customkotlinxandroidsynthetic.actions.MigrateParcelizeAction"
                text="Migrate Legacy Parcelize..." description="Preview and migrate legacy Parcelize references in a project or directory">
            <add-to-group group-id="SyntheticCompat.Tools" anchor="last"/>
        </action>
        <action id="SyntheticCompat.MigrateButterKnifeFile"
                class="com.github.kevin58cmd.customkotlinxandroidsynthetic.actions.MigrateButterKnifeFileAction"
                text="Migrate ButterKnife in This File..." description="Preview and migrate the selected Java or Kotlin file and required binding dependencies">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="SyntheticCompat.Tools" anchor="last"/>
        </action>
        <action id="SyntheticCompat.MigrateSystemBackProject"
                class="com.github.kevin58cmd.customkotlinxandroidsynthetic.actions.MigrateSystemBackProjectAction"
                text="Migrate Legacy System Back (Whole Project)..."
                description="Scan all project Java and Kotlin sources; preview migrations and cases requiring manual review">
            <add-to-group group-id="SyntheticCompat.Tools" anchor="last"/>
        </action>
        <action id="SyntheticCompat.MigrateSystemBack"
                class="com.github.kevin58cmd.customkotlinxandroidsynthetic.actions.MigrateSystemBackAction"
                text="Migrate Legacy System Back in This File..."
                description="Preview and migrate safe onBackPressed overrides; identify KEYCODE_BACK handlers requiring manual review">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="SyntheticCompat.Tools" anchor="last"/>
        </action>
        <action id="SyntheticCompat.MigrateButterKnife"
                class="com.github.kevin58cmd.customkotlinxandroidsynthetic.actions.MigrateButterKnifeAction"
                text="Migrate ButterKnife to findViewById..." description="Preview and migrate Java and Kotlin files in the selected directory or project">
            <add-to-group group-id="SyntheticCompat.Tools" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
